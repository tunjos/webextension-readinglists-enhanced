{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "short_description": "__MSG_extensionDescription__",
  "version": "1.4.0",
  "default_locale": "en",
  "manifest_version": 3,
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.wikipedia.org/*",
    "https://*.wikivoyage.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "js": ["dist/browser-polyfill.min.js", "content.js"],
      "matches": ["https://*.wikipedia.org/*", "https://*.wikivoyage.org/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_Addtolist_16x16.png",
      "32": "icon_Addtolist_32x32.png",
      "48": "icon_Addtolist_48x48.png",
      "128": "icon_Addtolist_128x128.png"
    }
  },
  "page_action": {
    "default_title": "__MSG_pageActionTitle__",
    "default_popup": "popup.html",
    "show_matches": [
      "https://*.wikipedia.org/*",
      "https://*.wikivoyage.org/*"
    ],
    "default_icon": {
      "16": "icon_Addtolist_16x16.png",
      "32": "icon_Addtolist_32x32.png"
    }
  },
  "icons": {
    "16": "icon_Addtolist_16x16.png",
    "32": "icon_Addtolist_32x32.png",
    "48": "icon_Addtolist_48x48.png",
    "128": "icon_Addtolist_128x128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "MacCtrl+Shift+A"
      },
      "description": "__MSG_commandDescription__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "webextension-readinglists-enhanced@tunjos.co",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  }
}
